# Browser: public Supabase credentials only
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-public-key

# Scrapers/database maintenance only
SUPABASE_PROJECT_ID=your-project-id
DB_PASSWORD=your-database-password
TMDB_API_KEY=your-tmdb-key

# Optional local scraper builder (never put OAuth secrets in VITE_ variables)
BUILDER_HOST=127.0.0.1
BUILDER_PORT=8788
# Optional Photon-compatible geocoder; searches are explicit, cached and throttled.
# BUILDER_GEOCODER_URL=https://photon.komoot.io/api/
# Optional: choose a browser for JavaScript inspection (auto-fallback: Chrome, Edge).
# BUILDER_BROWSER_CHANNEL=chrome
BUILDER_PAGE_URL="http://localhost:5173/CinemaCalendar/#/add-cinema"
BUILDER_GITHUB_CLIENT_ID=
BUILDER_GITHUB_CLIENT_SECRET=
BUILDER_GITHUB_CALLBACK_URL=http://localhost:5173/builder-api/auth/callback
BUILDER_GITHUB_OWNER=luigirinaldi
BUILDER_GITHUB_REPO=CinemaCalendar
BUILDER_GITHUB_BASE=dev
# Development defaults to the local companion. Production defaults to
# ${VITE_SUPABASE_URL}/functions/v1/scraper-builder. Override either if needed:
# VITE_SCRAPER_BUILDER_URL=https://builder.example.com/builder-api

# Supabase Edge Function secrets (set separately through Supabase, never VITE_):
# BUILDER_PAGE_URL=https://luigirinaldi.github.io/CinemaCalendar/dev/#/add-cinema
# BUILDER_ALLOWED_ORIGINS=https://luigirinaldi.github.io
# Generate a random 32-byte hex key for encrypted sessions (64 hex characters).
# BUILDER_SESSION_KEY=
# Reuse BUILDER_GITHUB_CLIENT_ID / SECRET / OWNER / REPO / BASE above.
# Hosted OAuth callback is the page URL without a fragment, plus ?builderLogin=1.
